# Public site config — add the same keys in Vercel → Settings → Environment Variables,
# then Redeploy. NEXT_PUBLIC_ values are baked in at build time.

# Reown / WalletConnect Cloud Project ID (enables QR connect for Rainbow, Trust, etc.).
# Injected wallets (MetaMask, Rabby, Brave, OKX) work without this.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_WALLET_API=

# Optional override for the quote/status proxy.
RELAY_API_URL=https://api.relay.link
