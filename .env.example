# Public site config — add the same keys in Vercel → Settings → Environment Variables,
# then Redeploy. NEXT_PUBLIC_ values are baked in at build time.

# Optional factory once you deploy contracts/TokenFactory.sol to Robinhood Chain.
NEXT_PUBLIC_FACTORY_ADDRESS=

# Display ETH/USD used for market caps (curve itself is ETH-denominated).
NEXT_PUBLIC_ETH_USD=2440

# Social
NEXT_PUBLIC_X_URL=https://x.com/helixliquidity
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/helixliquidity

# Wallet — Robinhood Chain mainnet (4663). Leave empty for local demo connect.
# Put your Reown / WalletConnect Cloud Project ID here (or an https RPC URL).
NEXT_PUBLIC_WALLET_API=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_RH_RPC=
NEXT_PUBLIC_ALCHEMY_API_KEY=
