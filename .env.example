# Public site config — add the same keys in Vercel → Settings → Environment Variables,
# then Redeploy. NEXT_PUBLIC_ values are baked in at build time.

# Main token. After you create the token, paste its contract here and Redeploy.
# Name, ticker, on-chain logo, USD price, and market stats load from
# DexScreener / GeckoTerminal automatically.
NEXT_PUBLIC_TOKEN_CONTRACT=0x1Ad69dDD9D98dD71b6211339A1801fD128A3925D
NEXT_PUBLIC_TOKEN_CONTRACT_SOL=

# Optional overrides. Leave empty so the contract’s name / ticker / logo win.
# Demo (placeholder contract) brands as Fomo Ping / PING.
NEXT_PUBLIC_TOKEN_SYMBOL=
NEXT_PUBLIC_TOKEN_NAME=
NEXT_PUBLIC_TOKEN_LOGO=/logo.png

# Social + launchpad
NEXT_PUBLIC_X_URL=https://x.com/fomoping
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/fomoping
NEXT_PUBLIC_PONS_URL=
NEXT_PUBLIC_PONS_ID=

# Optional ISO time (example: 2026-09-20T16:00:00.000Z). Empty = no countdown.
NEXT_PUBLIC_LAUNCH_AT=

# Short blurb shown on the token page and in the site description
NEXT_PUBLIC_TOKEN_INFO=You heard it. That's the entry. Fair-launch meme on Robinhood Chain with real fee-sharing pools — not an official Robinhood product.

# Wallet — Robinhood Chain mainnet (4663). Leave empty for local demo connect.
# Put your Reown / WalletConnect Cloud Project ID here (or an https RPC URL).
NEXT_PUBLIC_WALLET_API=c3a2a7e9d8f090369b0b8b2421807c9c
# Optional aliases
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_RH_RPC=
NEXT_PUBLIC_ALCHEMY_API_KEY=
